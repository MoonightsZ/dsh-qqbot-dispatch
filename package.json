{
  "name": "dsh-qqbot-dispatch",
  "version": "0.1.0",
  "private": true,
  "description": "Community add-on for @tencent-connect/dsh-qqbot: dispatch tasks to QQ sessions and manage customizable feature modules",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "prepack": "npm run build"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "session-resolver.js",
    "tools.js",
    "routes.js",
    "service-turn.js",
    "upstream-sender.js",
    "notification-dispatcher.js",
    "module-discovery.js",
    "modules/",
    "group-names.js",
    "group-health.js",
    "features.js",
    "cron.js",
    "qqbot-creds.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-app-boot": ">=0.1.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "qqbot"
  ],
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
