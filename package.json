{
  "name": "dsh-tool-qqbot-dispatch",
  "version": "0.1.0",
  "private": true,
  "description": "DSH tool and sidebar page: QQ Bot sessions and task dispatch for @tencent-connect/dsh-qqbot",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "features.js",
    "liquipedia.js",
    "qqbot-creds.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0",
    "@deepseek-ai/dsh-app-boot": ">=0.1.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "qqbot"
  ]
}
