{
  "id": "casual-chat",
  "label": "偶尔闲聊",
  "description": "每天定点检查一次；按概率、冷却和安静时段设置，偶尔在指定 QQ 会话发起简短聊天。",
  "provider": "builtin",
  "fields": [
    { "key": "chancePercent", "kind": "text", "label": "触发概率", "default": "30" },
    { "key": "cooldownHours", "kind": "text", "label": "发送冷却小时数", "default": "72" },
    { "key": "quietStart", "kind": "text", "label": "安静时段开始", "default": "22" },
    { "key": "quietEnd", "kind": "text", "label": "安静时段结束", "default": "9" },
    { "key": "topics", "kind": "topics", "label": "话题池", "default": [] }
  ],
  "defaults": { "source": { "id": "none" }, "intervalMinutes": 1440, "scheduleMode": "cron", "cron": ["0 19 * * *"] }
}
